ular","unseen":false,"pinned":false,"unpinned":null,"excerpt":"If it’s my private repository, would BugBot also git clone the code to the cursor server side? \nI’m quite concerned about the privacy issues. \nIf BugBot does not clone the repository code, How BugBot work?","visible":true,"closed":false,"archived":false,"bookmarked":null,"liked":null,"thumbnails":null,"tags":[],"tags_descriptions":{},"like_count":4,"views":172,"category_id":4,"featured_link":null,"op_like_count":0,"has_accepted_answer":false,"posters":[{"extras":null,"description":"Original Poster","user":{"id":53429,"username":"mrFranklin","name":"Franklin","avatar_template":"/user_avatar/forum.cursor.com/mrfranklin/{size}/61084_2.png","trust_level":1}},{"extras":null,"description":"Recent Poster","user":{"id":11208,"username":"tfriedel","name":"Thomas Friedel","avatar_template":"/user_avatar/forum.cursor.com/tfriedel/{size}/9133_2.png","trust_level":1}},{"extras":"latest","description":"Most Recent Poster","user":{"id":44409,"username":"jkaplan","name":"Jon Kaplan","avatar_template":"/user_avatar/forum.cursor.com/jkaplan/{size}/51468_2.png","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_group_id":42,"primary_group_name":"CursorStaff","trust_level":2}}]},{"fancy_title":"API or Git-based workflow to promote Bugbot learned rules into repository rules","id":171018,"title":"API or Git-based workflow to promote Bugbot learned rules into repository rules","slug":"api-or-git-based-workflow-to-promote-bugbot-learned-rules-into-repository-rules","posts_count":3,"reply_count":1,"highest_post_number":8,"image_url":null,"created_at":"2026-09-08T09:59:14.682Z","last_posted_at":"2026-09-08T12:45:05.455Z","bumped":true,"bumped_at":"2026-09-08T12:45:05.455Z","archetype":"regular","unseen":false,"pinned":false,"unpinned":null,"excerpt":"Feature request for product/service\nBugBot \nDescribe the request\nWe use Bugbot al