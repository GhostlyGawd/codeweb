# Dependencies
node_modules/

# Orchestrator output workspace (per-target runs; regenerable via scripts/run.mjs). The
# workspace writes its OWN .gitignore whitelisting the deliberate memory — annotations.json
# (F7 suppression judgement), history.jsonl (progression), and itself — and those deeper
# negations override this rule by git precedence (operator-ruled tracked, 2026-07-27, so the
# deadcode self-gate reads clean on a fresh clone). This dir-content ignore is the fallback for
# half-written workspaces; a dir-ignore (`.codeweb/`) would block the nested re-includes.
.codeweb/*

# Default run.mjs workspace target (.live/<slug>): generated analysis artifacts only —
# regenerable, never tracked. The hand-written dev tools that used to live here were graduated
# prototypes and were removed in the perf-quality round (finding 28; git history keeps them).
.live/
*.before

# Bench: evaluation corpus is cloned & pinned via bench/corpus.manifest.json (large, regenerable).
# Keep the clone script + manifest; ignore the cloned repos and any scratch run dirs.
bench/corpus/*/
bench/results/*.tmp
# Reproduction run outputs from bench/run-all.mjs (_env.json, _summary.json, _reproduce.log) —
# regenerable; the committed result JSONs are the source of truth.
bench/results/_*
bench/**/.cw/

# Python bytecode from the harness gate (spec lint, harness tests, evals)
__pycache__/
*.pyc

# OS / editor noise
.DS_Store
Thumbs.db
.claude/worktrees/
